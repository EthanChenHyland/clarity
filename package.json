{
  "name": "clarity",
  "version": "0.2.15",
  "description": "Open-source real-time AI overlay for macOS and Windows with screen, microphone, and system-audio assistance.",
  "license": "GPL-3.0-or-later",
  "author": "Clarity contributors",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "prepare:whisper": "node scripts/prepare-whisper-runtime.js",
    "verify:whisper-runtime": "node scripts/verify-whisper-runtime.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac zip",
    "dist:mac": "electron-builder --mac zip",
    "dist:win": "electron-builder --win --publish never",
    "pack:win": "electron-builder --win --dir --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:linux:arm64": "electron-builder --linux AppImage --arm64",
    "prepare:renderer": "node scripts/prepare-renderer.js",
    "prestart": "npm run prepare:renderer",
    "pretest": "npm run prepare:renderer"
  },
  "keywords": [
    "electron",
    "overlay",
    "ai",
    "assistant",
    "macos",
    "apple-silicon",
    "windows",
    "windows-11"
  ],
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^2.12.0",
    "katex": "^0.18.7",
    "lucide-static": "^0.468.0",
    "mammoth": "^1.8.0",
    "markdown-it": "^15.0.2",
    "markdown-it-texmath": "^1.0.0",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.18.0"
  }
}
